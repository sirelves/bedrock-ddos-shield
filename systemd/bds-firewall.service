[Unit]
Description=bedrock-ddos-shield firewall + autoblocker
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/bds-firewall.sh
ExecStart=/usr/local/sbin/bds-autoblock.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
