[Unit]
Description=bedrock-ddos-shield watchdog (flood/softnet + anti-cheat regression)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/bds-watch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
